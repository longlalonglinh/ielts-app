### CÁCH SỬA TRIỆT ĐỂ

Mở file **`src/components/Student/Practice/PracticeCardView.tsx`** và sửa lại 2 chỗ sau:

#### 1. Sửa hàm `normalizeToCardItem` (ở khoảng dòng 48 - 60)

Thay thế đoạn kiểm tra đầu hàm bằng logic kiểm tra xem các phần tử bên trong `options` đã thực sự là object có `id` và `text` hay chưa:

```tsx
function normalizeToCardItem(input: PracticeCard | PracticeCardItem): PracticeCardItem {
  // KIỂM TRA CHUẨN: Chỉ coi là PracticeCardItem nếu options là mảng object đã có id và text
  if (
    'type' in input && 
    input.type && 
    Array.isArray((input as PracticeCardItem).options) &&
    (input as PracticeCardItem).options.length > 0 &&
    typeof (input as PracticeCardItem).options[0] === 'object' &&
    (input as PracticeCardItem).options[0] !== null &&
    'id' in (input as PracticeCardItem).options[0] &&
    'text' in (input as PracticeCardItem).options[0]
  ) {
    return input as PracticeCardItem;
  }

  const legacy = input as PracticeCard;

  // If card has an embedded item
  if (legacy.item) {
    return legacy.item;
  }

  // Lấy danh sách options chuẩn (ưu tiên options_data, nếu không có thì map từ options string)
  let type: PracticeQuestionType = legacy.type || 'multiple-choice';
  let options: PracticeOption[] = [];

  if (legacy.options_data && Array.isArray(legacy.options_data) && legacy.options_data.length > 0) {
    options = legacy.options_data.map((opt: any, idx: number) => ({
      id: opt.id || `opt_${idx + 1}`,
      text: opt.text || (typeof opt === 'string' ? opt : `Option ${idx + 1}`),
      isCorrect: Boolean(opt.isCorrect),
      distractorRationale: opt.distractorRationale || opt.explanation || ''
    }));
  } else if (legacy.options && Array.isArray(legacy.options) && legacy.options.length > 0) {
    const target = (legacy.cloze_target || '').toLowerCase().trim();
    const acceptedTargets = [target, ...(legacy.accepted_answers || []).map(a => a.toLowerCase().trim())];

    options = legacy.options.map((optItem: any, idx: number) => {
      const optText = typeof optItem === 'string' ? optItem : (optItem.text || optItem.label || '');
      const cleanOpt = optText.toLowerCase().trim();
      const isCorrect = typeof optItem === 'object' && 'isCorrect' in optItem 
        ? Boolean(optItem.isCorrect) 
        : acceptedTargets.includes(cleanOpt);

      return {
        id: (typeof optItem === 'object' && optItem.id) ? optItem.id : `opt_${idx + 1}`,
        text: optText,
        isCorrect: isCorrect,
        distractorRationale: (typeof optItem === 'object' && optItem.distractorRationale)
          ? optItem.distractorRationale
          : isCorrect
            ? 'Chính xác.'
            : 'Phương án gây nhiễu.'
      };
    });
  }

  // Tự động chuyển sang multiple-response nếu có nhiều hơn 1 đáp án đúng
  const correctCount = options.filter(o => o.isCorrect).length;
  if (correctCount > 1 || (legacy.min_selections && legacy.min_selections > 1)) {
    type = 'multiple-response';
  }

  return {
    id: legacy.id || `card_${Date.now()}`,
    type,
    cognitiveLevel: legacy.cognitive_level || 'applying',
    learningOutcomeId: legacy.learning_outcome_id || 'LO-WORD-FORMATION',
    promptPrefix: legacy.prompt_prefix || (type === 'multiple-response' ? 'Select ALL correct answers that apply:' : 'Choose the most appropriate option:'),
    stimulusText: legacy.sentence_en || legacy.sentence || (legacy as any).question || '',
    promptSuffix: legacy.prompt_suffix || '',
    options,
    minSelections: legacy.min_selections || (correctCount > 0 ? correctCount : 1),
    maxSelections: legacy.max_selections || (options.length > 0 ? options.length : 1),
    itemDifficulty: legacy.difficulty === 'hard' ? 1.5 : legacy.difficulty === 'easy' ? -0.8 : 0.0,
    targetWord: legacy.target_word || legacy.cloze_target,
    partOfSpeech: legacy.part_of_speech,
    explanation: legacy.explanation,
    grammarPoints: legacy.grammar_points,
    hints: legacy.hints
  };
}

```

