19:  */
20: export function openIndexedDB(): Promise<IDBDatabase> {
21:   return new Promise((resolve, reject) => {
22:     if (typeof window === 'undefined' || !window.indexedDB) {
23:       return reject(new Error('IndexedDB is not supported in this environment'));
24:     }
25: 
26:     if (dbInstance) {
27:       return resolve(dbInstance);
28:     }
29: 
30:     const request = window.indexedDB.open(DB_NAME, DB_VERSION);
31: 
32:     request.onupgradeneeded = (event) => {
33:       const db = (event.target as IDBOpenDBRequest).result;
34: 
35:       if (!db.objectStoreNames.contains('exams')) {
36:         db.createObjectStore('exams', { keyPath: 'exam_code' });
37:       }
38: 
39:       if (!db.objectStoreNames.contains('submissions')) {
40:         db.createObjectStore('submissions', { keyPath: 'submission_id' });
41:       }
42: 
43:       if (!db.objectStoreNames.contains('cheat_logs')) {
44:         db.createObjectStore('cheat_logs', { keyPath: 'log_id' });
45:       }
46: 
47:       if (!db.objectStoreNames.contains('practice_decks')) {
48:         db.createObjectStore('practice_decks', { keyPath: 'deck_id' });
49:       }
50: 
51:       if (!db.objectStoreNames.contains('key_values')) {
52:         db.createObjectStore('key_values', { keyPath: 'key' });
53:       }
54:     };
55: 
56:     request.onsuccess = (event) => {
57:       dbInstance = (event.target as IDBOpenDBRequest).result;
58:       resolve(dbInstance);
59:     };
60: 
61:     request.onerror = (event) => {
62:       console.error('IndexedDB open error:', (event.target as IDBOpenDBRequest).error);
63:       reject((event.target as IDBOpenDBRequest).error);
64:     };
65:   });
66: }
