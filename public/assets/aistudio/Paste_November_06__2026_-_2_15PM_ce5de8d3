  const handleLiveDraftChange = (liveDraft: ExamData) => {
    setExam(liveDraft);
  };

  // Nhân bản đề thi (Duplicate Exam)
  const handleDuplicateExam = async (sourceExam: ExamData) => {
    const newCode = `${sourceExam.exam_code}_COPY_${Date.now().toString().slice(-3)}`;
    const cloned: ExamData = {
      ...JSON.parse(JSON.stringify(sourceExam)),
      exam_code: newCode,
      title: `${sourceExam.title} (Copy)`,
      status: 'draft',
      is_draft: true,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    };
    await saveExamToIndexedDB(cloned);
    await refreshVaultExams();
    setExam(cloned);
    setActiveTab('builder');
  };

  // Xóa đề thi khỏi Local Vault
  const handleDeleteVaultExam = async (code: string) => {
    if (!window.confirm(`Xác nhận xóa vĩnh viễn đề thi [${code}] khỏi bộ nhớ trình duyệt?`)) return;
    await deleteExamFromIndexedDB(code);
    await refreshVaultExams();
  };

