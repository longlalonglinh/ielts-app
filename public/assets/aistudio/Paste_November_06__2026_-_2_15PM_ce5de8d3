```tsx
// Thay thế các đoạn tương ứng trong src/components/Admin/VisualExamBuilder.tsx

// 1. Mở rộng Interface VisualExamBuilderProps (Dòng 89-93):
interface VisualExamBuilderProps {
  initialExamData: ExamData;
  onSaveExam: (exam: ExamData) => void;
  onDraftChange?: (liveDraft: ExamData) => void;
  isSaving?: boolean;
}

export const VisualExamBuilder: React.FC<VisualExamBuilderProps> = ({
  initialExamData,
  onSaveExam,
  onDraftChange,
  isSaving = false
}) => {
  // Kho lưu trữ tạm thời các kỹ năng bị ẩn khi chuyển sang One-Skill / Two-Skills (Chống mất dữ liệu)
  const skillStashRef = useRef<{
    passages?: any[];
    listening_questions?: any[];
    audio_url?: string;
    audio_title?: string;
    writing_task1_prompt?: string;
    writing_task1_image?: string;
    writing_task2_prompt?: string;
  }>({});
  const lastExternalCodeRef = useRef<string>(initialExamData?.exam_code || '');

  // 2. Đồng bộ Form khi Admin chọn đề thi khác từ Ngân hàng đề hoặc UploadModule (Thêm sau dòng 274):
  useEffect(() => {
    if (
      initialExamData &&
      initialExamData.exam_code &&
      initialExamData.exam_code !== lastExternalCodeRef.current
    ) {
      lastExternalCodeRef.current = initialExamData.exam_code;
      reset(formatInitialData(initialExamData));
      setSelectedPassageIdx(0);
    }
  }, [initialExamData, reset]);

  // 3. Đẩy Live Draft Snapshot ra PreviewModule sau 250ms mỗi khi gõ phím (Thêm sau dòng 692):
  useEffect(() => {
    if (!onDraftChange) return;
    const timer = setTimeout(() => {
      const currentFormValues = getValues();
      const liveDraft = buildExamFromForm(
        currentFormValues,
        currentFormValues.is_draft ? 'draft' : 'published'
      );
      onDraftChange(liveDraft);
    }, 250);

    return () => clearTimeout(timer);
  }, [
    watchedPassages,
    watchedExamCode,
    watchedTask1Image,
    watch('audio_url'),
    watch('audio_title'),
    watch('skills'),
    watch('exam_type'),
    watch('title'),
    watch('duration_mins'),
    watch('writing_task1_prompt'),
    watch('writing_task2_prompt'),
    watch('listening_questions')
  ]);

  // 4. Hàm chuyển đổi Kỹ năng An toàn Không Xóa Dữ liệu (Thay cho các onClick ở dòng 1146-1255):
  const handleSwitchSkillPreset = (
    targetExamType: 'one_skill' | 'two_skills' | 'full_test',
    nextSkills: ('listening' | 'reading' | 'writing')[],
    totalMins: number
  ) => {
    const current = getValues();

    // Cất dữ liệu hiện tại vào Stash trước khi ẩn
    if (current.passages && current.passages.length > 0) {
      skillStashRef.current.passages = current.passages;
    }
    if (current.listening_questions && current.listening_questions.length > 0) {
      skillStashRef.current.listening_questions = current.listening_questions;
    }
    if (current.audio_url) skillStashRef.current.audio_url = current.audio_url;
    if (current.audio_title) skillStashRef.current.audio_title = current.audio_title;
    if (current.writing_task1_prompt) skillStashRef.current.writing_task1_prompt = current.writing_task1_prompt;
    if (current.writing_task1_image) skillStashRef.current.writing_task1_image = current.writing_task1_image;
    if (current.writing_task2_prompt) skillStashRef.current.writing_task2_prompt = current.writing_task2_prompt;

    setValue('exam_type', targetExamType, { shouldDirty: true });
    setValue('skills', nextSkills, { shouldDirty: true });
    setValue('duration_mins', totalMins, { shouldDirty: true });

    // Khôi phục từ Stash nếu kỹ năng được bật lại
    if (nextSkills.includes('reading') && (!current.passages || current.passages.length === 0) && skillStashRef.current.passages) {
      setValue('passages', skillStashRef.current.passages as any, { shouldDirty: true });
    }
    if (nextSkills.includes('listening')) {
      if ((!current.listening_questions || current.listening_questions.length === 0) && skillStashRef.current.listening_questions) {
        setValue('listening_questions', skillStashRef.current.listening_questions as any, { shouldDirty: true });
      }
      if (!current.audio_url && skillStashRef.current.audio_url) {
        setValue('audio_url', skillStashRef.current.audio_url, { shouldDirty: true });
      }
    }
    if (nextSkills.includes('writing')) {
      if (!current.writing_task1_prompt && skillStashRef.current.writing_task1_prompt) {
        setValue('writing_task1_prompt', skillStashRef.current.writing_task1_prompt, { shouldDirty: true });
      }
      if (!current.writing_task1_image && skillStashRef.current.writing_task1_image) {
        setValue('writing_task1_image', skillStashRef.current.writing_task1_image, { shouldDirty: true });
      }
      if (!current.writing_task2_prompt && skillStashRef.current.writing_task2_prompt) {
        setValue('writing_task2_prompt', skillStashRef.current.writing_task2_prompt, { shouldDirty: true });
      }
    }

    setActiveSection(nextSkills[0]);
  };

  // 5. Nâng cấp Validation Linter (Thêm vào khối Pre-Publish Readiness Checklist ở dòng 405-462):
  const allQuestionIds = allQs.map(q => (q.question_id || '').trim()).filter(Boolean);
  const duplicateIds = allQuestionIds.filter((id, index) => allQuestionIds.indexOf(id) !== index);

  // Kiểm tra khớp số lượng token [blank_X] trong văn bản và câu hỏi
  const passageBlankTokens = (watchedValues.passages || []).flatMap(p => {
    const matches = (p.text || '').match(/\[blank_\d+\]/g);
    return matches || [];
  });

  // Kiểm tra câu Multiple Choice bị thiếu options
  const invalidMcqQuestions = allQs.filter(
    q => (q.question_type === 'multiple_choice' || q.question_type === 'multiple_choice_multiple_answers') &&
         (!q.options || q.options.length < 2)
  );

