    "express": "^4.21.2",
    "googleapis": "^185.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "vite": "^6.2.3",
    "zod": "^4.6.1"
  },
